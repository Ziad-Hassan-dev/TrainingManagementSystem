@model List<CourseEnrollment>
@{
	ViewData["Title"] = "Index";
}

<h1>CourseEnrollment</h1>
<a asp-action="Create" asp-controller="CourseEnrollment" class="btn btn-success">Create</a>
<table class="table table-bordered table-hover">
	<thead>
		<tr>
			<th>Trainee</th>
			<th>Course</th>
			<th>EnrollmentDate</th>
			<th>Status</th>
			<th>Edit</th>
			<th>Delete</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var crsEnroll in Model)
		{
			<tr>
				<td>@crsEnroll.Trainee.Name</td>
				<td>@crsEnroll.Course.Name</td>
				<td>@crsEnroll.EnrollmentDate</td>
				<td>@crsEnroll.Status.ToString()</td>
				<td>
					<a asp-action="Edit" asp-controller="CourseEnrollment" asp-route-id="@crsEnroll.Id">Edit</a>
				</td>
				<td>
					<form method="post" asp-action="Delete" asp-controller="CourseEnrollment" asp-route-id="@crsEnroll.Id">
						<button type="submit" class="btn btn-danger btn-sm"
								onclick="return confirm('Are you sure you want to delete this Trainee?');">
							Delete
						</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>