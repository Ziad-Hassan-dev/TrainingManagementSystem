@model List<Instructor>
@{
	ViewData["Title"] = "Index";
}

<h1>Instructors</h1>
<a asp-action="Create" asp-controller="Instructor" class="btn btn-success">Create</a>
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger m-3">@TempData["Error"]</div>
}
@if(Model.Any())
{
	<table class="table table-bordered table-hoverd">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Email</th>
				<th>Phone</th>
				<th>Address</th>
				<th>DepartmentName</th>
				<th>Edit</th>
				<th>Delete</th>
			</tr>
		</thead>
		<tbody>
			@foreach(var ins in Model)
			{
				<tr>
					<td>@ins.Id</td>
					<td>@ins.Name</td>
					<td>@ins.Email</td>
					<td>@ins.Phone</td>
					<td>@ins.Address</td>
					<td>@ins.Department.Name</td>
					<td>
						<a asp-action="Edit" asp-controller="Instructor" asp-route-id="@ins.Id">Edit</a>
					</td>
					<td>
						<form method="post" asp-action="Delete" asp-controller="Instructor" asp-route-id="@ins.Id">
							<button type="submit" class="btn btn-danger btn-sm"
									onclick="return confirm('Are you sure you want to delete this instructor?');">
								Delete
							</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>	
}
else
{
	<div class="alert alert-info">No Instructor Found</div>
}