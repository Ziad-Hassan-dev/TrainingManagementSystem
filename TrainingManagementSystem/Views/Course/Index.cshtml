@model List<Course>
@{
	ViewData["Titel"] = "Index";
}
<h1>Courses</h1>
<a asp-action="Create" asp-controller="Course" class="btn btn-success">Create</a>
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger m-3">@TempData["Error"]</div>
}
<table class="table table-bordered table-hoverd">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Description</th>
			<th>Degree</td>
			<th>MinDegree</th>
			<th>Hours</th>
			<th>InstructorName</th>
			<th>DepartmentName</th>
			<th>Edit</th>
			<th>Delete</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var crs in Model)
		{
			<tr>
				<td>@crs.Id</td>
				<td>@crs.Name</td>
				<td>@crs.Description</td>
				<td>@crs.Degree</td>
				<td>@crs.MinDegree</td>
				<td>@crs.Hours</td>
				<td>@crs.Instructor.Name</td>
				<td>@crs.Department.Name</td>
				<td>
					<a 
						asp-action="Edit" 
						asp-controller="Course" 
						asp-route-id="@crs.Id"
					>
						Edit
					</a>
				</td>
				<td>
					<form method="post" asp-action="Delete" asp-controller="Course" asp-route-id="@crs.Id">
						<button type="submit" value="Delete" class="btn btn-danger btn-sm"
						onclick="return confirm('Are you sure you want to delete this Course?');"
						>
							Delete
						</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>