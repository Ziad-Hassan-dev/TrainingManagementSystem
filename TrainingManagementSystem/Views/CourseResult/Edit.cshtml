@model CourseResultFormViewModel
@{
	ViewData["Title"] = "Edit";
}

<form method="post" asp-action="Edit" asp-controller="CourseResult" asp-route-id="@Model.EnrollmentId">
	<div>
		<label asp-for="EnrollmentId"></label>
		<select asp-for="EnrollmentId" asp-items="Model.Enrollments" class="form form-control">
			<option value="-1">--Select Enrollment--</option>
		</select>
	</div>
	<div>
		<label asp-for="Degree"></label>
		<input asp-for="Degree" class="form form-control"/>
	</div>
	<div>
		<label asp-for="ResultDate"></label>
		<input asp-for="ResultDate" class="form form-control"/>
	</div>
	<input type="submit" value="Save" class="btn btn-success"/>
</form>