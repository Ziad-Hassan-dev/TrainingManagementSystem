@model IEnumerable<Department>
@{
	ViewData["Title"] = "Index";
}

<h1>Departments</h1>
<a asp-action="Create" asp-controller="Department" class="btn btn-success">Create</a>
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger m-3">@TempData["Error"]</div>
}
@if (Model.Any())
{
	<table class="table table-bordered table-hover">
		<thead>
			<tr>
				<th>ID</th>
				<th>Name</th>
				<th>Description</th>
				<th>Edit</th>
				<th>Delete</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var dept in Model)
			{
				<tr>
					<td>@dept.Id</td>
					<td>@dept.Name</td>
					<td>@dept.Description</td>
					<td>
						<a asp-action="Edit"
						asp-controller="Department" 
						asp-route-id="@dept?.Id">Edit</a>
					</td>
					<td>
						<a asp-action="Delete" 
						asp-controller="Department" 
						asp-route-id="@dept?.Id">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">No Department Found</div>
}