@model List<Trainee>
@{
	ViewData["Title"] = "Index";
}
<h1>Trainees</h1>
<a asp-action="Create" asp-controller="Trainee" class="btn btn-success">Create</a>
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger m-3">@TempData["Error"]</div>
}
<table class="table table-bordered table-hover">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Email</th>
			<th>Address</th>
			<th>Phone</th>
			<th>Edit</th>
			<th>Delete</th>
		</tr>
	</thead>

	<tbody>
		@foreach(var trainee in Model)
		{
			<tr>
				<td>@trainee.Id</td>
				<td>@trainee.Name</td>
				<td>@trainee.Email</td>
				<td>@trainee.Address</td>
				<td>@trainee.Phone</td>
				<td>
					<a asp-action="Edit" asp-controller="Trainee" asp-route-id="@trainee.Id">
						Edit
					</a>
				</td>
				<td>
					<form asp-action="Delete" asp-controller="Trainee" asp-route-id="@trainee.Id">
						<button type="submit" class="btn btn-danger btn-sm"
								onclick="return confirm('Are you sure you want to delete this Trainee?');">
							Delete
						</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>